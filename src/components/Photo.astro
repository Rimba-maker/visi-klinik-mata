---
// Pexels photo in a plain rounded frame. `cls` carries placement and aspect ratio.
interface Props {
  id: number; // Pexels photo id
  alt: string; // pass '' only for purely decorative photos
  w?: number; // display width in px, a 2x copy is requested for sharp screens
  cls?: string;
  pos?: string; // CSS object-position
  eager?: boolean; // above the fold: load eagerly with high priority
}
const { id, alt, w = 800, cls = '', pos = 'center', eager = false } = Astro.props;
const base = `https://images.pexels.com/photos/${id}/pexels-photo-${id}.jpeg?auto=compress&cs=tinysrgb`;
---

<figure class:list={['ph', cls]}>
  <img
    src={`${base}&w=${w}`}
    srcset={`${base}&w=${w} 1x, ${base}&w=${w * 2} 2x`}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    style={`object-position:${pos}`}
  />
</figure>
