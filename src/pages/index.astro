---
import '../styles/global.css';
import Photo from '../components/Photo.astro';

---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Visi Klinik Mata — Klinik Mata Spesialis Jakarta, Lasik & Katarak</title>
  <meta name="description" content="Klinik mata spesialis dengan 15+ dokter Sp.M. Lasik Wavelight FS200, operasi katarak, treatment retina, mata anak, glaukoma. 5 cabang Jabodetabek + Surabaya." />
  <meta property="og:title" content="Visi Klinik Mata — Klinik Mata Spesialis" />
  <meta property="og:description" content="Lasik, katarak, glaukoma, dry eye, pediatric ophthalmology. 15+ Sp.M bersertifikat. 5 cabang Jabodetabek + Surabaya." />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://images.pexels.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Marcellus&display=swap" rel="stylesheet" />
  <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" defer></script>
</head>
<body>

  <!-- almond (eye) clip shape, used by Photo almond -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs><clipPath id="almond" clipPathUnits="objectBoundingBox"><path d="M0,0.5 C0.2,0.02 0.8,0.02 1,0.5 C0.8,0.98 0.2,0.98 0,0.5Z" /></clipPath></defs>
  </svg>

  <!-- ─── NAVBAR ─── -->
  <nav class="nav" aria-label="Navigasi utama">
    <div class="nav__in">
      <a href="#top" class="nav__logo">
        <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="13" cy="13" r="12"/><circle cx="13" cy="13" r="6"/><circle cx="13" cy="13" r="1.8" fill="currentColor" stroke="none"/></svg>
        Visi Klinik Mata
      </a>
      <ul class="nav__links">
        <li><a href="#layanan">Layanan</a></li>
        <li><a href="#lasik">Lasik</a></li>
        <li><a href="#dokter">Dokter</a></li>
        <li><a href="#kacamata">Kacamata</a></li>
        <li><a href="#lokasi">Lokasi</a></li>
      </ul>
      <a href="#booking" class="btn btn-primary"><i class="ph-bold ph-calendar-blank" aria-hidden="true"></i>Book Pemeriksaan</a>
    </div>
  </nav>

  <main id="top">

  </main>


</body>
</html>
