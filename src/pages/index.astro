const testi = [
  {
    tag: 'Cataract Surgery',
    quote:
      '"Mama saya 68 tahun, katarak bilateral. Surgery di Visi pakai IOL multifokal, sekarang bisa baca koran tanpa kacamata baca. Tetangga sampai nanya operasi di mana."',
    by: 'Bu Nina, anak pasien katarak',
    initial: 'N',
  },
  {
    tag: 'Pediatric Ophthalmology',
    quote:
      '"Anak saya 7 tahun didiagnosis amblyopia (lazy eye). dr. Sari sabar handle anak, kasih plan vision therapy 6 bulan. Hasilnya signifikan dan anak jadi lebih percaya diri."',
    by: 'Pak Bayu, ayah pasien anak',
    initial: 'B',
  },
  {
    tag: 'Diabetic Retinopathy',
    quote:
      '"Diabetic 15 tahun, dapat retinopathy stadium 2. Treatment anti-VEGF injection rutin di Visi sudah 2 tahun, kondisi stabil. Senang ada klinik yang treat saya seperti partner, bukan sekadar pasien."',
    by: 'Pak Bambang, 58 tahun',
    initial: 'B',
  },
];

const faq = [
  [
    'Lasik aman tidak?',
    'Lasik adalah prosedur yang sudah dilakukan jutaan kali worldwide dengan safety record tinggi. Risiko minor sangat minimal jika dilakukan dokter berpengalaman dengan peralatan modern seperti Wavelight FS200.',
  ],
  [
    'Setelah Lasik, mata bisa minus lagi?',
    'Hasil Lasik permanen untuk kondisi refraksi saat ini. Namun presbyopia (mata tua) tetap bisa terjadi pada usia 40+ — ini proses alami aging yang tidak berkaitan dengan prosedur Lasik.',
  ],
  [
    'Operasi katarak BPJS, caranya bagaimana?',
    'BPJS menanggung biaya phacoemulsification + IOL monofokal standar. Upgrade ke IOL multifokal/toric dikenakan biaya tambahan pribadi. Pasien perlu rujukan dari faskes tingkat pertama (FKTP) terlebih dahulu.',
  ],
  [
    'Anak myopia, harus pakai kacamata?',
    'Tergantung tingkat minusnya. Minus di bawah -1 mungkin tidak perlu full-time. Dokter pediatric ophthalmology akan membuat rencana yang paling sesuai — termasuk opsi myopia control seperti Ortho-K atau MiSight.',
  ],
  [
    'Dry eye bisa sembuh total?',
    'Dry eye bisa dikelola (managed) dengan sangat baik — tidak selalu "sembuh" 100% tergantung penyebabnya. IPL therapy sangat efektif untuk meibomian gland dysfunction dan memberikan perbaikan jangka panjang.',
  ],
  [
    'Bisa langsung fitting kacamata setelah periksa?',
    'Ya. Optical shop in-clinic tersedia di setiap cabang. Setelah pemeriksaan, langsung fitting kacamata atau contact lens — frame premium (Ray-Ban, Oakley) maupun affordable, dengan lensa Zeiss, Essilor, dan Hoya.',
  ],
];

const cities = [
  { name: 'Jakarta Selatan', img: 35581806, alt: 'Deretan gedung Jakarta saat matahari terbenam' },
  { name: 'Jakarta Pusat', img: 7361776, alt: 'Pemandangan udara Monumen Nasional di Jakarta' },
  { name: 'BSD, Tangerang', img: 30496412, alt: 'Fasad kaca gedung modern' },
  { name: 'Bekasi', img: 14792540, alt: 'Jalan ramai dengan sepeda motor di kota Indonesia' },
