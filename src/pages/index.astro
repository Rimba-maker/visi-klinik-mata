    specialty: 'Cataract & Anterior Segment',
    schedule: 'Rabu · Jumat · Sabtu',
    img: 8376309,
  },
  { name: 'dr. Linda Wijaya, Sp.M(K)', specialty: 'Oculoplastic Surgery', schedule: 'Selasa · Jumat', img: 15641079 },
