const tech: { icon: IconName; name: string; brand: string; description: string }[] = [
  {
    icon: 'scan',
    name: 'OCT — Optical Coherence Tomography',
    brand: 'Heidelberg Spectralis',
    description: 'Imaging retina & optic nerve resolusi tinggi untuk diagnosis akurat glaukoma dan retinopathy.',
  },
  {
    icon: 'lightning',
    name: 'Wavelight FS200 + EX500',
    brand: 'Alcon (US)',
    description:
      'Platform Lasik kelas dunia. Blade-free femtosecond laser, akurasi submikron untuk Femto-LASIK & SMILE.',
  },
  {
    icon: 'target',
    name: 'Auto Refractor & Corneal Topography',
    brand: 'Nidek / Zeiss',
    description: 'Pemeriksaan refraksi akurat & mapping kornea untuk menentukan Lasik eligibility.',
  },
  {
    icon: 'drop',
    name: 'LipiView & LipiFlow',
    brand: 'TearScience',
    description: 'Diagnostic & treatment dry eye dari root cause meibomian gland dysfunction secara non-invasif.',
  },
  {
    icon: 'chart-bar',
    name: 'Visual Field Analyzer',
    brand: 'Humphrey HFA3',
    description: 'Standar emas deteksi glaukoma. Tersedia di seluruh cabang Visi Klinik Mata.',
